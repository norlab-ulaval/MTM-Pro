# An .aiignore file follows the same syntax as a .gitignore file.
# .gitignore documentation: https://git-scm.com/docs/gitignore

# ....Junie Related................................................................................
/.junie/ai_ignored/

# ....A2G Related..................................................................................
!/.junie/a2g_config.yml
!/.junie/guidelines.md
!/.junie/ai_artifact/**/*
!/.junie/ai_agent_guidelines/**/*
!/.junie/**/*
/.junie/ai_agent_guidelines/README.human.md
/.junie/ai_agent_guidelines/template/
/.junie/ai_agent_guidelines/recipes/
/.junie/ai_agent_guidelines/visual/

# ....Repository Related...........................................................................
/notebooks/**/experiment/

**/CHANGELOG.md
**/artifact/*
**/data/external_data/*
**/data/repository_data/*
**/data/shared_data/*
!**/README.md
**/secrets/*
*.secret

!/artifact/apptainer/dna_hpc_server_config_IMPROVED.bash
!/artifact/apptainer/dna_registry_to_apptainer_sif_converter_IMPROVED.sh
!/artifact/apptainer/dna_tar_to_apptainer_sif_converter_IMPROVED.sh
!/artifact/apptainer/README.md


# ....Jetbrains....................................................................................
**/.run/
**/.idea/

# ....General File Type............................................................................
venv/
__pycache__/
*.benchmarks/
*.pytest_cache/
.DS_Store

# ....Media........................................................................................
**/video/*.meta.json
*.mp4


